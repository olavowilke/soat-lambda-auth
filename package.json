{
  "name": "soat-lambda-auth",
  "version": "1.0.0",
  "private": true,
  "description": "Function serverless de autenticacao por CPF - Tech Challenge FIAP SOAT Fase 3",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "package": "npm run build && cd dist && zip -r ../lambda-auth.zip .",
    "dev": "node --experimental-strip-types src/dev-server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "jose": "^5.9.6",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^2.1.8",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
